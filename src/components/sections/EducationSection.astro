---
import SectionHeading from "../SectionHeading.astro";
import education from "../../data/education.json";
import { formatDateRange } from "../../lib/dates";
---

<section id="education">
  <SectionHeading title="Education" />
  <div class="flat-list">
    {
      education.map((entry) => (
        <div class="flat-row">
          <div class="flat-row-heading">
            <span>{entry.institution}</span>
            <span class="entry-date">{formatDateRange(entry.startDate, entry.endDate)}</span>
          </div>
          <div class="flat-row-sub">
            {entry.degree}
            {entry.gpa ? ` · GPA: ${entry.gpa}` : ""}
          </div>
          <div class="flat-row-sub">{entry.location}</div>
        </div>
      ))
    }
  </div>
</section>
