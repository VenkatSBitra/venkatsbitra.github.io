---
import { getCollection } from "astro:content";
import SectionHeading from "../SectionHeading.astro";
import { formatDateRange, sortByStartDateDesc } from "../../lib/dates";

const entries = sortByStartDateDesc((await getCollection("mentorship")).map((e) => e.data));
---

<section id="mentorship">
  <SectionHeading title="Mentorship" />
  <div class="flat-list">
    {
      entries.map((entry) => (
        <div class="flat-row">
          <div class="flat-row-heading">
            <span>
              {entry.course}
              {entry.courseCode ? ` (${entry.courseCode})` : ""}
            </span>
            <span class="entry-date">{formatDateRange(entry.startDate, entry.endDate)}</span>
          </div>
          <div class="flat-row-sub">
            {entry.role} · {entry.institution}
          </div>
        </div>
      ))
    }
  </div>
</section>
